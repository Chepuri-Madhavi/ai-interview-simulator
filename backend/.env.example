# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Required ---
# Get a key at https://console.anthropic.com/ . It stays on the server and is never sent to the browser.
ANTHROPIC_API_KEY=
# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# --- Optional ---
APP_ENV=development                     # set to "production" to refuse the default SECRET_KEY
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium                 # low | medium | high | xhigh | max
DATABASE_URL=sqlite:///./data/app.db    # or postgresql+psycopg://user:pass@localhost:5432/interviews (pip install -r requirements-postgres.txt)
STORAGE_DIR=./data/storage              # recordings are stored here, one private folder per user
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=8
MAX_RECORDING_MB=500
ACCESS_TOKEN_MINUTES=720

# Speech-to-text: "browser" = live transcription in Chrome/Edge (default, no setup);
# "faster_whisper" = transcribe answer audio on this server (pip install -r requirements-stt.txt)
STT_PROVIDER=browser
WHISPER_MODEL=base

# Test-only: LLM_PROVIDER=fake returns canned AI responses for the automated tests. Do not use for real interviews.
LLM_PROVIDER=anthropic
